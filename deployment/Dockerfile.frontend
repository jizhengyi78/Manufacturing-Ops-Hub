# 制造业Agent — 前端 Dockerfile (多阶段构建)
FROM node:20-alpine AS builder

WORKDIR /app
COPY frontend/chat/package.json frontend/chat/vite.config.js ./
RUN npm install

COPY frontend/chat/ ./
RUN npm run build

# 生产阶段: nginx serve
FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

# LLM Configuration
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Model Routing
DEFAULT_MODEL=deepseek-chat
FALLBACK_MODEL=qwen-turbo
SIMPLE_TASK_MODEL=qwen-turbo
COMPLEX_TASK_MODEL=deepseek-chat

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=

# Elasticsearch
ES_HOST=http://localhost:9200
ES_USER=
ES_PASSWORD=

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=manufacturing
POSTGRES_PASSWORD=manufacturing
POSTGRES_DB=manufacturing_agent

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Embedding
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIM=1024

# Reranker
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu

# JWT
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# A2A Signing
A2A_SECRET_KEY=your-a2a-secret-key
A2A_SIGNATURE_ALGORITHM=HS256
A2A_KEY_ROTATION_DAYS=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=30
A2A_MAX_CONCURRENT=20
MAX_PARALLEL_AGENTS=3

# Token Budget (daily per workshop)
TOKEN_BUDGET_WARN_RATIO=0.8
TOKEN_BUDGET_DEGRADE_RATIO=0.9
TOKEN_BUDGET_LIMIT_RATIO=1.0

# Circuit Breaker
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_COOLDOWN_SECONDS=30
CIRCUIT_MAX_COOLDOWN_SECONDS=300

# Checkpoint
CHECKPOINT_TTL_SECONDS=3600

# Offline Mode
OFFLINE_ENABLED=true
OFFLINE_LLM_MODEL=qwen-2.5-14b-int4

# Demo Password (开发/演示环境使用)
DEMO_PASSWORD=

# Logging
LOG_LEVEL=INFO
